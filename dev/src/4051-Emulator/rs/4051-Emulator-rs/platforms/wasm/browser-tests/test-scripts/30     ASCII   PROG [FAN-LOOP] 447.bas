100 INIT101 REM GENERATE 100 RAYS OVER 90 DEGREES; EVERY TENTH REACHES 105105 PAGE110 SET DEGREES115 REM DRAW THE LONG RAY AT EACH TENTH INDEX120 FOR K=0 TO 9130 I=10*K140 R=105150 A=I*90/99160 X=R*COS(A)170 Y=R*SIN(A)180 MOVE 0,0190 DRAW X,Y195 REM FILL THE NINE SHORTER RAYS BETWEEN LONG RAYS200 FOR J=1 TO 9210 I=10*K+J220 R=100230 A=I*90/99240 X=R*COS(A)250 Y=R*SIN(A)260 MOVE 0,0270 DRAW X,Y280 NEXT J290 NEXT K300 END