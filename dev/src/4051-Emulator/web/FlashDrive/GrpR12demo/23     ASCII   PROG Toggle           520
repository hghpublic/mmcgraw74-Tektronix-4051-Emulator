100 REM TOGGLE example110 INIT120 SET DEGREES130 REM Create a pentagon.140 DIM F(14),F$(21)150 DATA -50,-50,75,50,57.7,73.8,29.8,64.7,29.8,35.3,57.7,26.2,75,50160 READ F170 CALL "CHANGE",F,F$180 REM Blink each segment in turn.190 FOR J=1 TO 6200 I=J210 CALL "RDRAW",F$,-40,0,0220 REM Change from draw to Move, or vice versa.230 CALL "TOGGLE",F$,I235 PRINT I240 CALL "RDRAW",F$,-40,0,0250 REM Change it back the way it was.260 CALL "TOGGLE",F$,I265 PRINT I270 NEXT J280 CALL "RDRAW",F$,-40,0,0290 END