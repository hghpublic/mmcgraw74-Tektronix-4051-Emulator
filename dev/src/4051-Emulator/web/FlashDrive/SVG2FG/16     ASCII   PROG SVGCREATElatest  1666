90 REM SVG to R12 Conversion PGM MCM Nov 6, 202391 REM Edit SVG using SVG NEW or HPGL M/L conversion instructions92 REM edited SVG format - first line=title, 2nd line=attribution/src93 REM 1,X,Y Move, 0,X,Y Draw, 2=Error, 3,0,0 END of DATA, 4=maxX,maxY94 REM Optional 5=Xoffset,Yoffset (default 0,0) if not present before 495 REM Optional 6,-1,0 to invert Y(default 1,0) if not present before 496 REM program will position image on screen based on 4,5, and 697 REM Connect 4052/4054 /w R12 to PC with USB serial 9600 8N1 XON/XOFF100 INIT 110 DIM F$(72),R$(255*3),R(255*2)120 CALL "CMINIT"130 CALL "RATE",9600,5,0140 CALL "TSTRIN","","",""150 CALL "RSTRIN","","",""160 CALL "CMFLAG",3170 PAGE 180 PRINT "Input Flash Drive R12 NEW or BINARY DATA output file#: ";190 INPUT F200 PRINT "Now press RETURN and start PC Realterm SVG file SEND:";210 INPUT T$220 V=0230 R=0235 N=1240 X1=0250 Y1=0260 R$=""270 PAGE 280 FIND @5:F290 INPUT @40:T$300 INPUT @40:C$310 L=LEN(T$)320 L=72-(L+LEN(C$))330 MOVE 0,100340 PRINT T$350 MOVE 1.8055*(LEN(T$)+L),100360 PRINT C$370 WRITE @5:T$,C$380 X2=0390 Y2=0400 WRITE @5:X2,Y2410 V=V+1420 IF V<256 THEN 520430 CALL "CHANGE",R,R$440 WRITE @5:R$450 X2=ABS(R(509))460 Y2=ABS(R(510))470 WRITE @5:X2,Y2480 V=2490 R=0500 R(1)=-X2510 R(2)=-Y2520 INPUT @40:C,X,Y530 GO TO C+1 OF 540,570,660,710,620,680,702540 DRAW X,Y*N550 CALL "AGIN",R(V*2-1),R(V*2)560 GO TO 410570 MOVE X,Y*N580 CALL "AGIN",R(V*2-1),R(V*2)590 R(V*2-1)=-R(V*2-1)600 R(V*2)=-R(V*2)610 GO TO 410620 X0=X630 Y0=Y632 IF N=-1 THEN 640634 WINDOW X1,X0+X1,Y1,Y0+Y1636 GO TO 410640 WINDOW X1,X0+X1,Y1-Y0,Y1650 GO TO 410660 PRINT "2 is INVALID"670 GO TO 820680 X1=-X690 Y1=-Y700 GO TO 410702 N=X704 GO TO 410710 REM now write the last fragment to the Flash Drive720 V=V-1730 DIM S(V*2),S$(V*3)740 FOR I=1 TO V*2750 S(I)=R(I)760 NEXT I770 CALL "CHANGE",S,S$780 WRITE @5:S$790 WRITE @5:X2,Y2800 WRITE @5:"|EOG|"810 CLOSE 820 HOME 830 END 1000 REM SVG-R12 ADRAW viewer with title & attribution, MCM Nov 20231010 INIT 1020 DIM C$(255*3)1030 PAGE 1040 PRINT "Input R12 SVG file#: ";1050 INPUT F1060 PAGE 1070 FIND @5:F1080 READ @5:T$1090 READ @5:C$1100 WINDOW 0,130,0,1001110 L=LEN(T$)1120 L=72-(L+LEN(C$))1130 MOVE 0,1001140 PRINT T$1150 MOVE 1.8055*(LEN(T$)+L),1001160 PRINT C$1170 READ @5:X2,Y21180 MOVE X2,Y21190 READ @5:C$1200 IF C$="|EOG|" THEN 12301210 CALL "ADRAW",C$,1,X2,Y21220 GO TO 11701230 HOME 1240 END 