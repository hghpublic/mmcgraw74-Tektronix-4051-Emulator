100 REM we need serial to input the file and flash drive for output101 INIT 102 CALL "CMINIT"103 CALL "RATE",9600,5,0104 CALL "CMFLAG",3105 PAGE 110 REM break R12 output into 255 vector blocks120 DIM G(2*255),G$(3*255)130 G=0135 V=0140 G$=""150 FIND @5:53160 V=V+1170 IF V<256 THEN 300180 REM save the 255 vector R12 block190 V=V-1200 CALL "CHANGE",G,G$205 CALL "RDRAW",G$,1,0,0210 WRITE @5:G$220 REM grab last vector - make MOVE and store in front of next block230 X2=ABS(G(V*2-1))240 Y2=ABS(G(V*2))250 V=2260 G=0270 G(1)=-X2280 G(2)=-Y2290 REM now continue processing next data block300 INPUT @40:G(V*2-1),G(V*2)310 IF G(V*2-1)=3000 THEN 370320 GO TO 160370 REM now write the last fragment to the Flash Drive380 V=V-1390 DIM P(2*V),P$(3*V)400 P=0410 P$=""420 FOR I=1 TO V430 P(I*2-1)=G(I*2-1)440 P(I*2)=G(I*2)450 NEXT I460 CALL "CHANGE",P,P$470 CALL "RDRAW",P$,1,0,0480 WRITE @5:P$490 WRITE @5:"|EOG|"500 CLOSE 510 HOME 520 END 1000 REM relecture 1010 PAGE 1020 FIND @5:531040 READ @5:G$1050 IF G$="|EOG|" THEN 10801060 CALL "RDRAW",G$,1,0,01070 GO TO 10401080 HOME 1090 END 