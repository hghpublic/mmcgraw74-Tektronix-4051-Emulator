90 REM SVG to R12 Conversion PGM MCM Nov 6, 202391 REM Edit SVG using SVG NEW or HPGL instructions for M /w multiple L92 REM edited SVG format - first line=title, 2nd line=attribution/src93 REM 1,X,Y Move, 0,X,Y Draw, 2=Error, 3,0,0 END of DATA, 4=maxX,maxY94 REM Optional 5=Xoffset,Yoffset (default 0,0) if not present before 495 REM Optional 6,-1,0 to invert Y(default 1,0) if not present before 496 REM program will position image on screen based on 4,5, and 697 REM Connect 4052/4054 /w R12 to PC with USB serial 9600 8N1 XON/XOFF100 INIT 102 REM SET M4=1 IF 4054 OR 4054A WITH OR WITHOUT OPTION 30103 M4=INT(RND(0)*100)104 M4=M4=>50 AND M4<>70 AND M4<>79105 IF M4=0 THEN 110107 CHARSIZE 4110 DIM F$(72),R$(255*3),R(255*2)120 CALL "CMINIT"130 CALL "RATE",9600,5,0140 CALL "TSTRIN","","",""150 CALL "RSTRIN","","",""160 CALL "CMFLAG",3170 PAGE 180 PRINT "Input Flash Drive R12 NEW or BINARY DATA output file#: ";190 INPUT F200 PRINT "Now press RETURN and start PC Realterm SVG file SEND:";210 INPUT T$260 PAGE 270 V=0280 R=0290 N=1292 X0=0294 Y0=0296 V0=0298 V2=0300 WINDOW 0,130,0,100310 VIEWPORT 0,130,0,100320 R$=""330 FIND @5:F340 INPUT @40:T$350 INPUT @40:C$360 L=LEN(T$)370 L=72-(L+LEN(C$))380 MOVE 0,100390 PRINT T$391 GO TO 400392 IF M4=0 THEN 400394 CHARSIZE 2396 L=72-(L+LEN(C$)/1.65)397 GO TO 400398 L=72-(L+LEN(C$))400 MOVE 1.8055*(LEN(T$)+L),100410 PRINT C$420 WRITE @5:T$,C$460 V=V+1470 IF V<256 THEN 570475 V=V-1480 CALL "CHANGE",R,R$490 WRITE @5:R$500 X2=ABS(R(V*2-1))510 Y2=ABS(R(V*2))530 V=2540 R=0550 R(1)=-X2560 R(2)=-Y2570 INPUT @40:C,X,Y580 GO TO C+1 OF 590,610,700,880,630,720,750590 DRAW X,Y*N595 CALL "AGIN",R(V*2-1),R(V*2)600 GO TO 460610 MOVE X,Y*N612 CALL "AGIN",R(V*2-1),R(V*2)614 R(V*2-1)=-R(V*2-1)616 R(V*2)=-R(V*2)620 GO TO 460630 X1=X640 Y1=Y650 IF N=-1 THEN 680660 WINDOW X0,X1+X0,Y0,Y1+Y0670 GO TO 570680 WINDOW X0,X1+X0,Y0-Y1,Y0690 GO TO 570700 PRINT "2 is INVALID"710 GO TO 960720 X0=-X730 Y0=-Y740 GO TO 570750 N=X760 GO TO 570870 REM now write the last fragment to the Flash Drive880 V=V-1885 DIM P(2*V),P$(3*V)886 P=0887 P$=""890 FOR I=1 TO V900 P(I*2-1)=R(I*2-1)910 P(I*2)=R(I*2)920 NEXT I930 CALL "CHANGE",P,P$935 CALL "RDRAW",P$,1,0,0940 WRITE @5:P$950 WRITE @5:"|EOG|"960 CLOSE 970 HOME 980 END 1000 REM R12 VIEWER1010 INIT 1015 REM WINDOW 0,130,0,1001020 DIM C$(255*3)1030 PAGE 1040 PRINT "Input R12 SVG file#: ";1050 INPUT F1060 PAGE 1070 FIND @5:F1080 READ @5:T$1090 READ @5:C$1110 L=LEN(T$)1120 L=72-(L+LEN(C$))1130 MOVE 0,1001140 PRINT T$1150 MOVE 1.8055*(LEN(T$)+L),1001160 PRINT C$1170 READ @5:C$1200 IF C$="|EOG|" THEN 12301210 CALL "RDRAW",C$,1,0,01220 GO TO 11701230 HOME 1240 END 1999 REM show first 8 lines of ASCII SVG input data file2000 FIND @5:F-402010 FOR I=1 TO 82020 INPUT @5:T$2030 PRINT T$2040 NEXT I2050 END 