2,1,3,2,3,1,4,3,4,4,4,4,3,3,2,4,1800 DATA 1,1,2,1,1,2,2,3,1,4,2,4,3,4,4,4,4,3,3,2,4,2,4,1810 DATA 1,1,2,1,1,2,1,3,2,3,1,4,3,4,4,4,4,3,3,2,4,2,3,1,4,1820 DATA 1,1,2,1,2,2,1,2,1,3,1,4,2,4,3,4,4,4,3,3,4,3,4,2,3,1,4,1830 DATA 1,1,2,1,1,2,2,3,1,3,1,4,2,4,3,4,4,4,4,3,3,3,3,2,4,2,3,1,4,1840 DIM G(240),H(16),Z$(4095),Y$(15*3)850 READ G855 G=G*.126953125860 K=0870 FOR J=1 TO 15880 K=K+1890 H(J)=K900 K=K+J*2-1910 NEXT J920 H(16)=K+1930 REM PAGE 940 RETURN 950 REM DEBUG PRINT OF GRAYSCALE960 Y9=0970 FOR I=1 TO 15980 DELETE D,Z$990 DIM D(I*2),Z$(I*3)1000 K=11010 FOR J=H(I) TO H(I+1)-11020 D(K)=G(J)1030 K=K+11040 NEXT J1050 D=D/21060 CALL "CHANGE",D,Z$1070 CALL "RDOTS",Z$,1,I/4+0*(I-1),101080 NEXT I1090 END 