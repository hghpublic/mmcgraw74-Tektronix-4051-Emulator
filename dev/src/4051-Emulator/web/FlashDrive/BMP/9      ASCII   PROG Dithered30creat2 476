100 REM Dithered Option 30 Black & White Bitmap Viewer110 REM each READ contains one line of R12 dot string120 REM each string is converted to FP "MOVE" array130 REM then the array is used to MOVE/DRAW Opt 30 dot object140 REM then the Opt 30 dot object is made visible150 REM last READ contains "|EOG|" to stop viewer160 INIT 161 CALL "RATE",9600,5,0162 CALL "TSTRIN","","",""163 CALL "RSTRIN","","",""164 CALL "CMFLAG",3180 DIM Z$(1024*3)190 PRINT "Dithered Option 30 Bitmap CreatorInput Bitmap file#: ";200 INPUT F210 FIND @5:F220 PAGE 330 REM Load R12, Convert to FP, PRINT@40:V then X then Y data350 READ @5:Z$360 IF Z$="|EOG|" THEN 480365 DELETE Z370 V=LEN(Z$)/3380 DIM Z(2*V)390 CALL "CHANGE",Z$,Z400 PRINT @40:V410 FOR I=1 TO V-1 STEP 2420 PRINT @40:Z(I)430 NEXT I440 FOR I=2 TO V STEP 2450 PRINT @40:Z(I)460 NEXT I470 GO TO 350480 PRINT @40:0490 HOME 500 END 