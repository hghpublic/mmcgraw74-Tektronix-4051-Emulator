100 REM Dithered Option 30 Black & White Bitmap Viewer 20Feb2023 mcm110 REM each READ contains one line of R12 dot string120 REM each string is converted to FP "MOVE" array130 REM then the array is used to RMOVE/RDRAW Opt 30 dot object140 REM then the Opt 30 dot object is FIXed to make it visible150 REM last READ contains "|EOG|" to stop viewer160 INIT 170 BRIGHTNESS 1180 DIM Z$(1024*3)190 PRINT "Dithered Option 30 Bitmap ViewerInput Bitmap file#: ";200 INPUT F210 FIND @5:F220 PAGE 230 REM Convert R12 string to FP to load Option 30 directly240 READ @5:Z$250 IF Z$="|EOG|" THEN 440260 DELETE Z270 V=LEN(Z$)/3280 DIM Z(2*V)290 CALL "CHANGE",Z$,Z300 ROPEN 1310 VISIBILITY 1,0320 REM move to starting point and draw first dot330 MOVE Z(1),Z(2)340 RMOVE 0,0350 RDRAW 0,0360 REM now draw rest of dots on this line370 FOR I=3 TO 2*V STEP 2380 RMOVE Z(I)-Z(I-2),0390 RDRAW 0,0400 NEXT I410 RCLOSE 420 FIX 1430 GO TO 240440 HOME 450 END 