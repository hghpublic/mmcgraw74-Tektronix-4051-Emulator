100 REM Dithered Option 30 Black & White Bitmap Creator 20Feb2023 mcm110 REM each READ contains one line of R12 dot string120 REM each string is converted to FP "MOVE" array130 REM then the array is used to PRINT the FP RMOVE/RDRAW Opt 30 object150 REM last PRINT contains "0" to stop the Viewer program160 INIT 161 CALL "RATE",9600,5,0162 CALL "TSTRIN","","",""163 CALL "RSTRIN","","",""164 CALL "CMFLAG",3180 DIM Z$(1024*3)190 PRINT "Dithered Option 30 Bitmap CreatorInput R12 BMP file#: ";200 INPUT F210 FIND @5:F220 PAGE 230 REM Convert R12 string to FP to load Option 30 directly240 READ @5:Z$250 IF Z$="|EOG|" THEN 380260 DELETE Z270 V=LEN(Z$)/3280 DIM Z(2*V)290 CALL "CHANGE",Z$,Z320 REM save V,Z with PRINT@40:330 PRINT@40:V335 PRINT@40:Z(1),Z(2)336 REM calculate rest of values as relative to previous dot340 FOR I=3 TO 2*V STEP 2350 PRINT@40:Z(I)-Z(I-2),0360 NEXT I370 GO TO 240380 PRINT@40:0390 HOME 400 END 