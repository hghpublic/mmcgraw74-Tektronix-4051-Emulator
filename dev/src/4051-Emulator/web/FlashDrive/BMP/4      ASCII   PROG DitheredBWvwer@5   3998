100 REM Dithered BW R12 Picture Creator - Dec 8, 2023 Monty McGraw110 REM Supports max 1024x780 black and white BMP image120 REM Use PhotoDemon 9.0 https://github.com/tannerhelland/PhotoDemon130 REM Open color photo up to 1024x780. Autocorrect and Enhance140 REM Adjustments | Color to Monochrome | Auto Threshold, Sierra3 Ok150 REM Save As Bitmap 1-Bit per Pixel. Open Bitmap with HXD then160 REM export BMP file to Motorola S19 ASCII HEX format.170 REM Use Notepad++ to replace CRLF with "CR" to INPUT with this pgm.180 REM DDDemo.exe api.256file.com/dddemo.exe/en-download-98888.html190 REM shows format of bitmap. Data is packed 8-dots per byte MSB-LSB200 REM see https://en.wikipedia.org/wiki/BMP_file_format for details210 INIT 220 REM FNB tests bit X9 (LSB bit 1 to 8) in V9=value, Returns 1 or 0230 DEF FNB(X9)=INT(V9/2^X9-INT(V9/2^X9)+0.5)240 REM X5 & Y5 =absolute D/A X,Y for image lower left corner,N=bytes250 X5=0260 Y5=0270 PRINT "R12 Dithered Bitmap CREATOR Program - Dec 8, 2023 MCM"280 WINDOW 0,130,0,100290 DIM P$(3072),A$(80),D(2),Z$(6)300 P$=""310 REM for 405x Emulator @5: input file @6: output file320 REM test with BMP file on Flash Drive & Display"380 PRINT "Convert BMP S19 from @5: to R12 BIN on @6 in 405x EM"384 PRINT "Enter the @5: ASCII S19 INPUT file number: ";386 INPUT F5390 PRINT "Enter the @6: BINARY R12 OUTPUT file number: ";400 INPUT F6410 FIND @5:F5420 FIND @6:F6430 PAGE440 INPUT @5:T$450 INPUT @5:C$460 L=LEN(T$)470 L=72-(L+LEN(C$))480 MOVE 0,100490 PRINT T$500 MOVE 1.8055*(LEN(T$)+L),100510 PRINT C$520 WRITE @6:T$,C$570 INPUT @5:A$580 REM discard first $, check BM", filesize, then Image Width & Length590 INPUT @5:A$600 REM check for S1 vs S2 format610 B$=SEG(A$,1,2)620 S2=0630 IF B$="S1" THEN 650640 S2=2650 B$=SEG(A$,9+S2,4)660 IF B$="424D" THEN 690670 PRINT "Not BMP file format.Stop the program!"680 GO TO 384690 B$=SEG(A$,13+S2,2)700 CALL "HEXDEC",B$,F9710 B$=SEG(A$,15+S2,2)720 CALL "HEXDEC",B$,B722 B$=SEG(A$,17+S2,2)724 CALL "HEXDEC",B$,B0730 REM get filesize from file740 F0=65536*B0+256*B+F9750 B$=SEG(A$,45+S2,2)760 CALL "HEXDEC",B$,W0770 B$=SEG(A$,47+S2,2)780 CALL "HEXDEC",B$,B790 W0=256*B+W0800 REM 1 bpp Monochrome bitmap is stored 8-pixels per byte,810 REM aligned on DWORD boundaries for RowSize (R0) bytes820 B$=SEG(A$,53+S2,2)830 CALL "HEXDEC",B$,H0840 B$=SEG(A$,55+S2,2)850 CALL "HEXDEC",B$,B860 H0=256*B+H0870 REM Wikipedia Rowsize(bytes)=INT((BitsPerPixel*ImageWidth+31)/32)*4880 R0=INT((1*W0+31)/32)*4890 IF W0<1025 AND H0<781 THEN 920900 PRINT "Image is too Wide or too High: W=";W0;" H=";H0910 GO TO 510920 REM BW data is 1 for dot, 0 for no dot, MSB to LSB Left-Right930 REM BW data starts on second input at 33, skip last CRC byte940 INPUT @5:A$960 REM center the image if smaller than 1024x780970 X0=INT((1024-W0)/2)-1 MAX 0980 Y0=INT((780-H0)/2)-1 MAX 0990 C0=69-2+S21000 FOR Y=0 TO H0-1 MIN 7791010 REM count dots until W0 for end of row1020 W9=01030 FOR X=0 TO R0-11040 C0=C0+21050 IF C0<73+S2 THEN 10801060 C0=9+S21070 INPUT @5:A$1080 B$=SEG(A$,C0,2)1090 CALL "HEXDEC",B$,V91100 REM don't use loop for bits to exit end of row cleanly1110 X9=81120 X8=ABS(X9-8)1130 U=FNB(X9)1140 IF U=0 THEN 12301150 D(1)=X*8+X8+X01160 D(2)=Y+Y01170 D=D*0.1281180 CALL "CHANGE",D,Z$1190 CALL "RDOTS",Z$,1,0,01200 P0=LEN(P$)+11210 P$=REP(Z$,P0,0)1230 W9=W9+11240 IF W9<>W0 THEN 12501242 W9=01244 GO TO 12701250 X9=X9-11260 IF X9>0 THEN 11201270 NEXT X1275 IF LEN(P$)<3 THEN 12901280 WRITE @6:P$1290 P0=01300 P$=""1310 REM PRINT @5:Y1320 NEXT Y1330 WRITE @6:"|EOG|"1340 HOME1350 END 2000 REM view the R12 image you created2010 FIND @5:F62020 PAGE 2030 READ @5:T$2040 READ @5:C$2050 L=LEN(T$)2060 L=72-(L+LEN(C$))2070 MOVE 0,1002080 PRINT T$2090 MOVE 1.8055*(LEN(T$)+L),1002100 PRINT C$2120 READ @5:P$2130 IF P$="|EOG|" THEN 21602140 CALL "RDOTS",P$,1,0,02150 GO TO 21202160 HOME2170 END