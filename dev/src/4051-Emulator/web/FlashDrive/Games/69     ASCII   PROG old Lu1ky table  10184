$="RIGHT "3690 A$=A$&"SLINGSHOT"3700 T0=23710 GOSUB 41103720 IF S=-1 THEN 37403730 WRITE @5:"|EOG|",0,0,0,0,"|EOG|"3740 NEXT S3750 END 3760 REM subroutines to digitize X & Y in Graphic Display Units for R123770 REM digitize MOVE3780 CALL "AGIN",X9,Y93790 D(1)=-X93800 D(2)=-Y93810 CALL "CHANGE",D,Z$3820 E$=E$&Z$3830 RETURN 3840 REM digitize DRAW3850 CALL "AGIN",X9,Y93860 D(1)=X93870 D(2)=Y93880 CALL "CHANGE",D,Z$3890 E$=E$&Z$3900 RETURN 3910 REM SUB Make_Circle_Object(x,y,t,r)3920 REM let makeObject =3930 REM (3940 REM     x, y,          // position3950 REM     t,             // type and bumper strength3960 REM     r=WALL_RADIUS  // radius3970 REM )=> objects.push({x, y, t, r, v:0, w:0})3980 REM 3990 REM // object types4000 REM const TYPE_WALL       = 04010 REM const TYPE_BUMPER     = 14020 REM MAKE FULL CIRCLE4030 MOVE X+R*S,Y4040 GOSUB 37804050 FOR I=11.25 TO 360 STEP 11.254060 DRAW X+R*S*COS(I),Y+R*S*SIN(I)4070 GOSUB 38504080 NEXT I4090 RETURN 4100 REM SAVE R12 OBJECT NAME A$,T0,X,Y,R AND R12 VECTOR OUTLINE string4110 WRITE @5:A$,T0,X,Y,R,E$4120 E0=LEN(E$) MAX E04130 E$=""4140 A$="unknown"4150 RETURN 4160 REM MAKE HALF CIRCLE(X,Y,R,D8)4170 REM X,Y IS CENTER, R IS RADIUS, D8 IS STARTING ccw DEGREES OF ARC4180 MOVE X+R*S*COS(D8),Y+R*S*SIN(D8) MIN 10244190 GOSUB 37804200 FOR I=D8+11.25 TO D8+180 STEP 11.254210 DRAW X+R*S*COS(I),Y+R*S*SIN(I) MIN 10244220 GOSUB 38504230 NEXT I4240 RETURN 4500 FIND @5:704510 J=04520 PAGE 4530 IMAGE 24A,27X,24A4540 IMAGE 24A,27X,1D,1X,3D,1X,3D,1X,3D,1X,4D,S4550 READ @5:A$,E$4560 MOVE 0,Y04570 PRINT A$;" - ";E$4580 PRINT USING 4530:" ","T0  X   Y   R  LENGTH"4590 READ @5:A$,T0,X,Y,R,E$4600 IF A$="|EOG|" THEN 47004610 J=J+14620 HOME 4630 FOR K=1 TO J4640 PRINT 4650 NEXT K4660 PRINT USING 4540:A$;T0,X,Y,R,LEN(E$)4670 CALL "RDRAW",E$,1,0,04680 INPUT C$4690 GO TO 45904700 HOME 4710 END 5000 REM just draw the entire table with R12 objects5010 FIND @5:705020 PAGE