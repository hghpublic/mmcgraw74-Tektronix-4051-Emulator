100 PRI "Eratosthenes Sieve Prime Number Program - BYTE Sept 1981"102 REM emulate F(8190) 0-based bit FLAGs /w 7-bit ASCII string F$(1172)104 REM FNB tests bit X9 (LSB bit 1 to 8) in V9=value, Returns 1 or 0106 DEF FNB(X9)=INT(V9/2^X9-INT(V9/2^X9)+0.5)110 S = 8190120 DIM F$(1172)122 REM 405x Emulator @2: S1=TIMER in secs. Start time=T124 INPUT @2:T$126 GOSUB 300128 T=S1130 PRINT "Only 1 iteration"140 C=0142 F=1144 F$=""146 A$=CHR(127)150 FOR I=0 TO INT(S/7)+1160 F$=F$&A$170 NEXT I180 FOR I=0 TO S181 A$=SEG(F$,I+1,1)182 V9=ASC(A$)184 FOR J=1 TO 7188 F=FNB(J)190 IF F=0 THEN 270200 P = I+I + 3210 K = I + P220 IF K > S THEN 260230 D$=SEG(F$,INT((K+1)/7)+1,1)232 V8=ASC(D$)233 V8=V8-2^(K-7*INT((K+1)/7)+1)234 D$=CHR(V8)236 F$=REP(D$,I+1,1)240 K = K + P250 GO TO 220260 C = C + 1270 NEXT J274 NEXT I275 INPUT @2:T$276 GOSUB 300277 IMAGE FD," seconds"278 PRINT USING 276:S1-T280 PRINT C," PRIMES"290 REM  405x EM CALCULATE number of seconds S1 in HH:MM:SS part of T$300 B$=SEG(T$,11,2)310 S1=VAL(B$)*3600320 B$=SEG(T$,14,2)330 S1=S1+VAL(B$)*60340 B$=SEG(T$,17,2)350 S1=S1+VAL(B$)360 RETURN 