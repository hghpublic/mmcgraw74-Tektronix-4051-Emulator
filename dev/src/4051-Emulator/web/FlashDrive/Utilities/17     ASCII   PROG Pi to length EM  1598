1 REM Ported from BBC BASIC (https://rosettacode.org/wiki/Pi#BBC_BASIC)2 REM to Tektronix 4050 BASIC - mcm Jan 25, 20243 REM added INPUT #decimals for pi and 405x Emulator GPIB timer4 INIT 100 PRI "Compute pi to approximately how many decimals? (11 to 1000): ";110 INPUT D1120 IF D1<11 OR D1>1000 THEN 100130 D1=D1-1140 M=INT((D1/2+2)/7*49)150 D2=INT((M-13)/7)*2+1160 PRINT "Calculating pi to ";D2;" decimal places...  M=";M;" ";170 PRINT " 1        10        20        30        40        50"180 PRINT "  |        |         |         |         |         |";190 REM S=TIMER in seconds200 INPUT @2:A$210 GOSUB 680220 T=S230 DIM B(M+1),B$(10),P$(10),Q$(10),R$(10)240 REM use Tek 4050 array math to init B(M+1) length to store 'B(0)'250 B=20260 E=0270 L=2280 F=0290 FOR C=M TO 14 STEP -7300 D=0310 A=INT(C*2-1)320 FOR P=C TO 1 STEP -1330 D=INT(D*P+B(P+1)*100)340 B(P+1)=D-A*INT(D/A)350 D=INT(D/A)360 A=A-2370 NEXT P380 IF D<>99 THEN 410390 E=E*100+D400 L=L+2410 IF C<>M THEN 450420 PRINT "";INT(D/100)/10;430 E=D-100*INT(D/100)440 GO TO 620450 F=F+1460 Q=E+INT(D/100)470 P$=STR(Q)480 Q1=LEN(P$)-1490 Q$=SEG(P$,2,Q1)500 Q$="00"&Q$510 Q1=LEN(Q$)520 Q$=SEG(Q$,Q1-1,2)530 IF F-25*INT(F/25)<>0 THEN 590540 R$=SEG(Q$,1,1)550 PRINT R$560 R$=SEG(Q$,2,1)570 PRINT "  ";R$;580 GO TO 600590 PRINT Q$;600 E=D-100*INT(D/100)610 L=2620 NEXT C630 INPUT @2:A$640 GOSUB 680650 T=S-T660 PRINT "		                 Time= ";T;" seconds"670 END 680 REM    CALCULATE number of seconds in HH:MM:SS part of A$690 B$=SEG(A$,11,2)700 S=VAL(B$)*3600710 B$=SEG(A$,14,2)720 S=S+VAL(B$)*60730 B$=SEG(A$,17,2)740 S=S+VAL(B$)750 RETURN 