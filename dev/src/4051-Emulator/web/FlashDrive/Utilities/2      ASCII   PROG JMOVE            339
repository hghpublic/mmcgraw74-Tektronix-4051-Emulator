100 REM JMOVE EXAMPLE110 INIT 120 PAGE 130 REM GENERATE THE IMAGE OF A BOX140 DIM B(24),B$(36),C$(36),D(2),D$(3)150 DATA -50,-50,50,60,60,60,60,50,50,50,-50,-60,58.66,65,68.66,65160 DATA 68.66,55,60,50,-60,-60,68.66,65,-1.0E-3,-1.0E-3170 READ B,D180 CALL "CHANGE",B,B$185 CALL "CHANGE",D,D$190 C$=B$200 PRINT "MOVE JOYSTICK TO DESIRED SYMBOL LOCATION"210 PRINT "TYPE A CHARACTER TO PLACE THE SYMBOL"220 PRINT "TYPE E TO END PLACEMENT"230 REM USE THE JOYSTICK TO PLACE THE BOX240 B$=C$250 CALL "JMOVE",D$,-1000,X,Y,K$255 IF K$="" THEN 250260 IF K$="e" OR K$="E" THEN 290265 IF K$<>" " THEN 270266 PRINT "X=";X;"   Y=";Y267 GO TO 230270 CALL "RDRAW",B$,1,0,0280 GO TO 230290 END 