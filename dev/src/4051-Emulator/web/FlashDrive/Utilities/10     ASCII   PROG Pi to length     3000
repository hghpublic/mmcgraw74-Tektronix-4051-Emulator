100 REM "CALCULATING PI FOR HUNDREDS OF DIGITS"110 REM "THX TO ROSETTACODE.ORG FOR THE BASE OF THE PROGRAM"120 REM "SHOULD BE A BENCHMARK FOR THE BASIC INTERPRETER/COMPILER"130 REM "WRITTEN IN 2023 FOR FORUM.CLASSIC-COMPUTING.DE BY PETER DASSOW"135 REM "Ported to IoT BASIC by Guido Lehwalder, 2023"136 REM Ported to Tektronix 4050 BASIC by Monty McGraw 2024137 PAGE140 PRINT "Calculating Pi as a BASIC benchmark."150 PRINT "Enter number of digits (below or equal 1000): ";160 INPUT S$170 IF S$<>"" THEN 180172 PRINT "Nothing done."174 END180 N=VAL(S$)182 IF N<=1000 AND N>0 THEN 190184 PRINT "Not a valid number."188 GOTO 150190 REM "N DETERMINES ALSO THE ARRAY (ABOUT 3-4 TIMES BIGGER)"200 L1=INT(10*N/3)+16210 N1=1220 REM S1#=TIMER222 INPUT@2:A$224 GOSUB 900226 T=S230 REM "DIM STATEMENT COULD HAVE SIZE PARAMETER, BUT COMPATIBILITY..."240 DIM A(3350)245 A=0250 N9=0260 P1=0270 REM280 FOR J=1 TO L1290 A(J)=2300 NEXT J310 REM320 FOR J=1 TO N330 Q=0340 FOR I=L1 TO 1 STEP -1350 X=10*A(I)+Q*I360 A(I)=X-(2*I-1)*INT(X/(2*I-1))370 Q=INT(X/(2*I-1))380 NEXT I390 A(1)=Q-10*INT(Q/10)400 Q=INT(Q/10)410 IF Q<>9 THEN 420412 N9=N9+1414 GOTO 610420 IF Q<>10 THEN 540430 REM "Q==10"440 D=P1+1445 GOSUB 670450 IF N9<=0 THEN 500460 FOR K=1 TO N9470 D=0475 GOSUB 670480 NEXT K490 REM "END IF"500 P1=0510 N9=0520 GOTO 610530 REM "Q<>10"540 D=P1545 GOSUB 670550 P1=Q560 IF N9=0 THEN 610570 FOR K=1 TO N9580 D=9585 GOSUB 670590 NEXT K600 N9=0610 NEXT J620 C$=STR(P1)622 Z=LEN(C$)624 D$=SEG(C$,Z,1)626 PRINT D$;630 REM E1#=TIMER-S1#632 INPUT@2:A$634 GOSUB 900636 T=S-T638 PRINT "Calculation time ";T;" seconds."640 END650 REM660 REM "OUTPUT DIGITS"670 C$=STR(D)672 Z=LEN(C$)674 IF N1<>0 THEN 679675 D$=SEG(C$,Z,1) 677 PRINT D$;679 RETURN680 IF D<>0 THEN 690685 RETURN690 C$=STR(D)692 Z=LEN(C$)694 D$=SEG(C$,Z,1)696 PRINT D$;".";700 N1=0710 RETURN900 REM    CALCULATE number of seconds in HH:MM:SS part of A$910 B$=SEG(A$,11,2)920 S=VAL(B$)*3600930 B$=SEG(A$,14,2)940 S=S+VAL(B$)*60950 B$=SEG(A$,17,2)960 S=S+VAL(B$)970 RETURN1000 REM