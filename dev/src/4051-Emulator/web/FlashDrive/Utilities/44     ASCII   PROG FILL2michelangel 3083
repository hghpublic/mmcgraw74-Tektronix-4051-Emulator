100 INIT102 REM rotate Michelangelo left 90deg and swap "X" left and right103 VIEWPORT 32.5,130-32.5,0,100104 WINDOW 0,200,0,320105 DIM P(2,4),W(2,5),X(2),P1(2)106 REM set hatch Angle=0,no Crosshatch, Distance=2107 A=0108 C=0109 D=0.25110 PAGE115 P=0120 FIND@5:40130 INPUT@5:A$140 INPUT@5:A$145 L0=0150 INPUT@5:A$155 L0=L0+2160 B$=SEG(A$,1,1)170 IF B$="E" THEN 320180 INPUT@5: Y0,X0,Y1,X1190 P(1,1)=X0200 P(2,1)=Y0205 N=1210 REM MOVE X0,Y0220 REM DRAW X1,Y1230 IF X1<>P(1,1) OR Y1<>P(2,1) THEN 260235 REM calc CENTROID, DILATE & DRAW polygon with n points237 GOSUB 1000238 GO TO 150240 GOSUB 1000250 GO TO 150260 INPUT@5:A$265 L0=L0+2266 N=N+1270 INPUT@5: P(2,N),P(1,N),Y1,X1280 REM MOVE P(1,N),P(2,N)290 REM DRAW X1,Y1300 GO TO 230310 GO TO 150320 HOME330 END1000 REM Calc 'original' Polygon Area - use to scale dilation%1010 REM use triangle area A1=SQR(S0*(S0-A0)*(S0-B0)*(S0-C0))1020 REM where S0=(A0+B0+C0)/2 and A0,B0,C0 are length of each side1030 REM ex: A0=SQR((x2-x1)^2+(y2-y1)^2)1040 REM if polygon N=4, divide it into two triangles and add areas1050 REM then calculate minimum height from longest base= 2*A1/base1055 GO TO 12001060 A0=SQR((P(1,2)-P(1,1))^2+(P(2,2)-P(2,1))^2)1070 B0=SQR((P(1,3)-P(1,2))^2+(P(2,3)-P(2,2))^2)1080 C0=SQR((P(1,1)-P(1,3))^2+(P(2,1)-P(2,3))^2)1090 S0=(A0+B0+C0)/21100 A1=SQR(S0*ABS(S0-A0)*ABS(S0-B0)*ABS(S0-C0))1110 H1=2*A1/((A0 MAX B0) MAX (B0 MAX C0))MAX 0.51120 D1=0.81130 IF N=3 THEN 20001140 A0=SQR((P(1,3)-P(1,1))^2+(P(2,3)-P(2,1))^2)1150 B0=SQR((P(1,4)-P(1,3))^2+(P(2,4)-P(2,3))^2)1160 C0=SQR((P(1,1)-P(1,4))^2+(P(2,1)-P(2,4))^2)1170 S0=(A0+B0+C0)/21180 A1=A1+SQR(S0*ABS(S0-A0)*ABS(S0-B0)*ABS(S0-C0))1190 H1=H1+2*A1/((A0 MAX B0) MAX (B0 MAX C0)) MAX 0.51200 D1=0.751999 REM CALC CENTROID2000 X0=02020 Y0=02030 FOR I=1 TO N2040 X0=X0+P(1,I)2050 Y0=Y0+P(2,I)2060 NEXT I2070 X0=X0/N2080 Y0=Y0/N2090 REM DILATE POLYGON BY D1 AND OFFSET BY CENTROID2100 FOR I=1 TO N2110 P(1,I)=(P(1,I)-X0)*D1+X02120 P(2,I)=(P(2,I)-Y0)*D1+Y02130 NEXT I2140 REM NOW DRAW DILATED POLYGON2150 MOVE P(1,1),P(2,1)2160 FOR I=2 TO N2170 DRAW P(1,I),P(2,I)2180 NEXT I2190 DRAW P(1,1),P(2,1)3000 REM now add horizontal hatch lines to this polygon3010 S=1.0E+3073020 L=-1.0E+3073030 S1=SIN(A)3040 C1=COS(A)3050 FOR I=1 TO N3060 W(1,I)=P(1,I)*C1+P(2,I)*S13070 W(2,I)=-P(1,I)*S1+P(2,I)*C13080 S=S MIN W(2,I)3090 L=L MAX W(2,I)3100 NEXT I3110 W(1,N+1)=W(1,1)3120 W(2,N+1)=W(2,1)3130 Y2=S+0.5*D3140 IF Y2>L THEN 40003150 K=03160 FOR I=1 TO N3170 W1=W(2,I) MIN W(2,I+1)3180 IF Y2<W1 THEN 33003190 W2=W(2,I) MAX W(2,I+1)3200 IF Y2=>W2 THEN 33003210 X1=W(1,I)-(W(2,I)-Y2)*(W(1,I)-W(1,I+1))/(W(2,I)-W(2,I+1))3220 K=K+13230 J=K3240 IF J=1 THEN 32903250 IF X(J-1)=>X1 THEN 32903260 X(J)=X(J-1)3270 J=J-13280 GO TO 32403290 X(J)=X13300 NEXT I3310 FOR I=1 TO K3320 P1(1)=X(I)*C1-Y2*S13330 P1(2)=X(I)*S1+Y2*C13340 IF 2*INT(0.5*I)-I>-0.1 THEN 33703350 MOVE P1(1),P1(2)3360 GO TO 33803370 DRAW P1(1),P1(2)3380 NEXT I3390 Y2=Y2+D3400 GO TO 31404000 RETURN