920 RESTORE 950930 DELETE A1,A2940 DIM A1(4),A2(5)950 DATA 0,0,130,100960 DATA 65,50,10,0,360970 READ A1,A2980 CALL Circle(A2)990 POINTER A1(1),A1(2),A$1000 IF A$="" THEN 11001010 POINTER A1(3),A1(4),A$1020 MOVE A1(1),A1(2)1030 DRAW A1(3),A1(4)1040 CALL "XA",A1,A2,X,Y,X1,Y1,C01050 IF C0=0 THEN 9901060 CALL Symbol(X,Y)1070 IF C0=1 THEN 9901080 CALL Symbol(X1,Y1)1090 GO TO 9901100 RETURN 1110 REM SUBROUTINE TO DRAW X1120 SUB Symbol(X,Y)1130 MOVE X,Y1140 D=0.51150 RMOVE D,D1160 RDRAW -2*D,-2*D1170 RMOVE 0,2*D1180 RDRAW 2*D,-2*D1190 RMOVE -D,D1200 END SUB 1210 SUB Circle(A)1220 DIM A(5)1230 MOVE A(1)+A(3),A(2)1240 FOR I=A(4) TO A(5) STEP 21250 DRAW A(1)+COS(I)*A(3),A(2)+SIN(I)*A(3)1260 NEXT I1270 MOVE A(1),A(2)1280 END SUB 