100 REM Simple Smith Chart graticule, by Richard Russell, 12-Mar-2012110 REM Ported to Tek 4050 BASIC by Monty McGraw 11-Feb-2024120 REM requires 4052 or 4054 with MFM ROM or Char&Symbol ROM Pack130 REM BBC BASIC Libs:aaarc,aasector ported to Tek BASIC140 REM DEF PROC_aaarc(xc,yc,xr,yr,as,ad,t,C%,S%)150 REM Draw an arc:xc,yc = centre, xr,yr = radii,160 REM             as=start (right = 0),ad=sweep (degrees clockwise)170 REM PROC_aasector(xc, yc, xr, yr, as, ad, colour%)180 REM Draw an ellipse:xc,yc = centre, xr,yr = radii,190 REM             as=start (right = 0),ad=sweep (degrees clockwise)200 PAGE 210 SET DEGREES 220 REM W=window, S=size P=180/PI (P * radian = degrees)230 REM use 4052 Chr&Symbol ARC2 for aaarc, plus WINDOW for ellipses240 REM Chr&Sym CALL "ARC2",x_center,y_center,radius,startangle,endangle245 REM where positive angles are CCW from X-axis and neg angles are CW250 W=640260 S=512270 U=780/2280 WINDOW -20000,20000,-20000,20000290 P=180/PI300 REM VDU 23,22,window%;window%;8,16,16,128310 REM ORIGIN window%,window% - hmm this sets 0,0 at center?320 REM INSTALL @lib$+"aagfxlib" 330 REM REPEAT340 READ N350 IF N>1000 THEN 640360 R=S/(1+N)370 REM PROC_aaarc(S-R, 0, R, R, 0, 360, 1.0, &FF000000, 8)390 CALL "ARC2",S-R,0,R,360400 R=S/N410 IF ABS(S-R)<=R THEN 440420 A=90430 GO TO 450440 A=P*ASN((S-R)/R)450 REM PROC_aaarc(S, R, R, R, 90, A + 90, 1.0, &FF000000, 8)470 CALL "ARC2",S,R,R,-90,-A-90480 REM PROC_aaarc(S,-R,R,R,270-A-90,A+90,1.0, &FF000000, 8)500 CALL "ARC2",S,-R,R,-180-A,-A-90510 READ N520 R=S/(1+N)530 REM PROC_aasector(S-R, 0, R, R, 0, 360, &FFFFFFFF)550 CALL "ARC2",S-R,0,R,0,360560 R=S/N570 REM PROC_aasector(S, R, R, R, 90, 180, &FFFFFFFF)590 CALL "ARC2",S,R,R,-90,-180600 REM PROC_aasector(S, -R, R, R, 90, 180, &FFFFFFFF)620 CALL "ARC2",S,-R,R,-90,-180630 REM UNTIL N > 1000632 IF N <1000 THEN 340640 R=(S+W*SQR(2))/2650 T=R-S660 REM PROC_aaarc(0, 0, R, R, 0, 360, T, &FFFFFFFF, 0)680 CALL "ARC2",0,0,R,0,360690 REM PROC_aaarc(0, 0, S, S, 0, 360, 1.0, &FF000000, 8)710 CALL "ARC2",0,0,S,0,360720 REM PROC_aaline(-S, 0, S, 0, 1.0, &FF000000, 8)730 MOVE -S,0740 DRAW S,0750 END 760 DATA 0.05,0.2,0.15,0.2,0.1,1,0.3,1,0.5,1,0.7,1,0.9,1770 DATA 0.2,2,0.4,2,0.6,2,0.8,2,1.2,2,1.4,2,1.6,2,1.8,2780 DATA 1,5,2,5,3,5,4,5,5,10,10,20,20,21790 DATA 50,1000000