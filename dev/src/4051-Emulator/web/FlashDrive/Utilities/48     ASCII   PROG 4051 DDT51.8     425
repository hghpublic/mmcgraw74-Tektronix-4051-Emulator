100 INIT110 PRINT "CONVERT DDT51.8 HEX FILE TO ASCII BINARY FILE"120 REM  USES UTILITY @5:49 FROM FLASH DRV FOR INPUT AND @5:50 FOR OUT130 DIM C$(8192)140 C$=""150 FIND@5:49160 INPUT@5:A$170 IF A$="Z" THEN 290180 IF LEN(A$)<>40 THEN 160190 FOR I=0 TO 7200 B$=SEG(A$,I*5+3,2)210 CALL "HEXDEC",B$,B220 REM 4051 AND EMULATOR CANNOT HANDLE STRING CHR VALUE OVER 127230 REM COMMENT OUT LINE 240 WHEN RUNNING ON 4052A OR 4054A240 REM B=B MIN 127250 B$=CHR(B)260 C$=C$&B$270 NEXT I280 GO TO 160290 FIND@5:50300 WRITE@5:C$310 PRINT "DONE!"320 END