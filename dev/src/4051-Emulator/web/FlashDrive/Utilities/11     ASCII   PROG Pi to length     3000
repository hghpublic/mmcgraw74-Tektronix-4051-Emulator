1 REM ADOPTED FROM BBC BASIC (Rosetta Code)2 REM unrolled and modified for Tek 4050 BASIC - mcm Jan 25, 20243 INIT100 PRINT "Compute Pi to approximately many decimals? (11 to 1000): ";102 INPUT D1104 IF D1<11 OR D1>1000 THEN 100110 M=INT((((D1-1)/2)+2)/7)*50120 PRINT "Calculating pi to ";2*(INT((M/50)*7-2))+1;" digits:"140 DIM B(M+1)150 REM use Tek 4050 array math to init B array 160 B=20180 E=0190 L=2195 F=0200 FOR C=M TO 14 STEP -7210 D=0220 A=INT(C*2-1)230 FOR P=C TO 1 STEP -1240 D=INT(D*P+B(P+1)*100)250 B(P+1)=D-A*INT(D/A)260 D=INT(D/A)270 A=A-2280 NEXT P290 IF D<>99 THEN 300292 E=E*100+D294 L=L+2300 IF C<>M THEN 304301 PRINT "";INT(D/100)/10;302 E=D-100*INT(D/100)303 GO TO 320304 Q=E+INT(D/100)305 P$=STR(Q)306 Q1=LEN(P$)-1307 Q$=SEG(P$,2,Q1)308 Q$="00"&Q$309 Q1=LEN(Q$)310 Q$=SEG(Q$,Q1-1,2)311 PRINT Q$;312 E=D-100*INT(D/100)313 L=2315 F=F+1320 NEXT C321 D1 = 2*(INT(M/50)*7-2)+1322 PRINT "";M+1;F;D1;((D1-1)/2+2)/7*50+1;""