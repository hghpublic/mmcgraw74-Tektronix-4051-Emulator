1 REM  PI CALCULATION WITH SPIGOT (from Rosetta Code GW-BASIC)2 REM  Ported to Tektronix 4050 BASIC by mcm - 21 JAN 20243 INIT4 PRINT "Compute Pi to how many decimals? (4-100): ";5 INPUT N6 IF N<4 OR N>100 THEN 4100 REM N=MAX of 260 TO AVOID OVERFLOW110 L1=INT((10*N)/3+1)120 J=0122 K=0124 Q=0126 N9=0128 P1=0129 DIM A(L1)130 REM  VARIABLES FOR THE SUB140 R1=0142 I=0144 X=0200 REM  MAIN210 FOR J=1 TO L1212 A(J)=2214 NEXT J220 REM  START WITH 222...230 N9=0240 P1=0250 REM  FIRST P1 =0260 FOR J=1 TO N270 I=N-J272 GOSUB 1000274 Q=R1275 A(1)=Q-10*INT(Q/10)280 Q=INT(Q/10)290 IF Q<>9 THEN 300292 N9=N9+1300 IF Q<>10 THEN 310302 GOSUB 800310 IF (Q=9) OR (Q=10) THEN 320315 GOSUB 900320 NEXT J330 PRINT INT(P1);340 END 800 PRINT INT(P1+1);805 IF N9=0 THEN 820810 FOR K=1 TO N9812 PRINT "0";814 NEXT K820 P1=0825 N9=0830 RETURN 900 PRINT INT(P1);910 P1=Q920 IF N9=0 THEN 930925 GOSUB 950930 RETURN 950 FOR K=1 TO N9960 PRINT "9";962 NEXT K960 N9=0970 RETURN 1000 I=INT(I*10/3+16)1010 IF I<=L1 THEN 10201015 I=L11020 R1=01030 REM  REPEAT1040 X=INT(10*A(I)+R1*I)1050 R1=INT(X/(2*I-1))1060 A(I)=INT(X-(2*I-1)*INT(X/(2*I-1)))1070 I=I-11080 IF I>1 THEN 10401090 RETURN