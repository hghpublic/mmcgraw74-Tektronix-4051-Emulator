100 REM Tek 4050 Michelangelo with filled polygons - mcm 7 DEC 2024110 REM based on Georgios Patsos data file & 19 NOV 2024 post120 REM on facebook group "BASIC Programming Language"130 REM and Tekniques V3N1 "Shading Routine for Complex Shapes"140 INIT 150 PRINT "MichelangeloFilled=Y, Unfilled=N polygons, or Q to QUIT:";160 INPUT G$170 F=1180 IF G$<>"Q" AND G$<>"q" THEN 220190 PRINT @5,9:"ROOT"200 FIND @5:1210 OLD @5:220 IF G$="Y" OR G$="y" THEN 240230 F=0240 PRINT "View R12 file=V, Create R12 file=C or No R12-VERY SLOW=N: ";250 INPUT G$260 F0=0270 IF G$<>"V" AND G$<>"C" THEN 340280 F0=1290 DIM R(4),R$(6),T(8),T$(12),U(10),U$(15),F$(10000),H$(252)300 F$=""310 IF G$="V" THEN 2210320 FIND @6:4330 REM rotate Michelangelo left 90deg by swapping X and Y input DATA340 VIEWPORT 32.5,130-32.5,0,100350 WINDOW 0,200,0,320360 DIM P(2,4),W(2,5),X(2),P1(2)370 REM set hatch Angle=0, no Crosshatch, hatch Distance=0.25380 A=0390 C=0400 D=0.25410 PAGE 420 FIND @5:2430 INPUT @5:A$440 INPUT @5:A$450 L=0460 INPUT @5:A$470 L=L+2480 B$=SEG(A$,1,1)490 IF B$="E" THEN 820500 INPUT @5:Y0,X0,Y1,X1510 P(1,1)=X0520 P(2,1)=Y0530 N=1540 IF F=1 THEN 720550 IF F0=1 THEN 600560 MOVE X0,Y0570 DRAW X1,Y1580 GO TO 460590 REM draw original polygons - no fill and save R12 to file600 MOVE X0,Y0610 CALL "AGIN",X8,Y8620 DRAW X1,Y1630 CALL "AGIN",X9,Y9640 R(1)=-X8650 R(2)=-Y8660 R(3)=X9670 R(4)=Y9680 CALL "CHANGE",R,R$690 F$=REP(R$,LEN(F$)+1,0)700 GO TO 460710 REM detect final polygon vertex720 IF X1=P(1,1) AND Y1=P(2,1) THEN 790730 INPUT @5:A$740 L=L+2750 N=N+1760 INPUT @5:P(2,N),P(1,N),Y1,X1770 GO TO 720780 REM calc CENTROID, DILATE & DRAW polygon with n points790 GOSUB 1000800 GO TO 460810 REM write F$ in 252 byte or less (up to 46 R12 blocks) plus "|EOG|"820 HOME 830 IF F=1 AND F0=1 THEN 970840 IF F0=0 THEN 960850 REM write R12 unfilled vector F$ to file 3860 FIND @5:3870 L=LEN(F$)880 P0=0890 L0=252900 H$=SEG(F$,P0+1,L-P0 MIN 252)910 WRITE @5:H$920 P0=P0+(L-P0 MIN 252)930 IF P0<>L THEN 900940 H$="|EOG|"950 WRITE @5:H$960 GO TO 990970 F$="|EOG|"980 WRITE @6:F$990 END 1000 REM CALC CENTROID (X0=average of X, Y0=average of Y) 1010 X0=01020 Y0=01030 FOR I=1 TO N1040 X0=X0+P(1,I)1050 Y0=Y0+P(2,I)1060 NEXT I1070 X0=X0/N1080 Y0=Y0/N1090 REM DILATE POLYGON BY 75%1100 REM center polygon centroid at 0,0 then multiply by dilation%1110 REM then move polygon back to original centroid1120 FOR I=1 TO N1130 P(1,I)=(P(1,I)-X0)*0.75+X01140 P(2,I)=(P(2,I)-Y0)*0.75+Y01150 NEXT I1160 REM NOW DRAW DILATED POLYGON1170 IF F0=1 THEN 12601180 MOVE P(1,1),P(2,1)1190 FOR I=2 TO N1200 DRAW P(1,I),P(2,I)1210 NEXT I1220 DRAW P(1,1),P(2,1)1230 GO TO 16001240 REM NOW DRAW AND then WRITE R12 DILATED POLYGON TO FILE 41250 REM use R()&R$ for hatch,T()&T$ for triangle,U()&U$ for quad poly1260 IF N=4 THEN 14401270 MOVE P(1,1),P(2,1)1280 CALL "AGIN",X8,Y81290 T(1)=-X81300 T(2)=-Y81310 FOR I=2 TO N1320 DRAW P(1,I),P(2,I)1330 CALL "AGIN",X8,Y81340 T((I-1)*2+1)=X81350 T((I-1)*2+2)=Y81360 NEXT I1370 DRAW P(1,1),P(2,1)1380 CALL "AGIN",X8,Y81390 T(7)=X81400 T(8)=Y81410 CALL "CHANGE",T,T$1420 F$=REP(T$,LEN(F$)+1,0)1430 GO TO 16001440 MOVE P(1,1),P(2,1)1450 CALL "AGIN",X8,Y81460 U(1)=-X81470 U(2)=-Y81480 FOR I=2 TO N1490 DRAW P(1,I),P(2,I)1500 CALL "AGIN",X8,Y81510 U((I-1)*2+1)=X81520 U((I-1)*2+2)=Y81530 NEXT I1540 DRAW P(1,1),P(2,1)1550 CALL "AGIN",X8,Y81560 U(9)=X81570 U(10)=Y81580 CALL "CHANGE",T,T$1590 F$=REP(T$,LEN(F$)+1,0)1600 REM now add horizontal hatch lines to fill this polygon1610 S=1.0E+3071620 L0=-1.0E+3071630 S1=SIN(A)1640 C1=COS(A)1650 FOR I=1 TO N1660 W(1,I)=P(1,I)*C1+P(2,I)*S11670 W(2,I)=-P(1,I)*S1+P(2,I)*C11680 S=S MIN W(2,I)1690 L0=L0 MAX W(2,I)1700 NEXT I1710 W(1,N+1)=W(1,1)1720 W(2,N+1)=W(2,1)1730 Y2=S+0.5*D1740 IF Y2>L0 THEN 21701750 K=01760 FOR I=1 TO N1770 W1=W(2,I) MIN W(2,I+1)1780 IF Y2<W1 THEN 19001790 W2=W(2,I) MAX W(2,I+1)1800 IF Y2=>W2 THEN 19001810 X1=W(1,I)-(W(2,I)-Y2)*(W(1,I)-W(1,I+1))/(W(2,I)-W(2,I+1))1820 K=K+11830 J=K1840 IF J=1 THEN 18901850 IF X(J-1)=>X1 THEN 18901860 X(J)=X(J-1)1870 J=J-11880 GO TO 18401890 X(J)=X11900 NEXT I1910 FOR I=1 TO K1920 P1(1)=X(I)*C1-Y2*S11930 P1(2)=X(I)*S1+Y2*C11940 IF F0=1 THEN 20201950 IF 2*INT(0.5*I)-I>-0.1 THEN 19801960 MOVE P1(1),P1(2)1970 GO TO 19901980 DRAW P1(1),P1(2)1990 NEXT I2000 Y2=Y2+D2010 GO TO 17402020 IF 2*INT(0.5*I)-I>-0.1 THEN 20802030 MOVE P1(1),P1(2)2040 CALL "AGIN",X8,Y82050 R(1)=-X82060 R(2)=-Y82070 GO TO 21402080 DRAW P1(1),P1(2)2090 CALL "AGIN",X8,Y82100 R(3)=X82110 R(4)=Y82120 CALL "CHANGE",R,R$2130 F$=REP(R$,LEN(F$)+1,0)2140 NEXT I2150 Y2=Y2+D2160 GO TO 17402170 IF LEN(F$)=0 THEN 21902180 WRITE @6:F$2190 F$=""2200 RETURN 2210 PAGE 2220 IF F=0 THEN 22502230 FIND @5:42240 GO TO 22602250 FIND @5:32260 READ @5:F$2270 IF F$="|EOG|" THEN 23002280 CALL "RDRAW",F$,1,0,02290 GO TO 22602300 HOME 2310 END 