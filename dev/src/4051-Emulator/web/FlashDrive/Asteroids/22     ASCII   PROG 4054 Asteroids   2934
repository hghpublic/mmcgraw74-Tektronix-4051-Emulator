1 REM Asteroids-4054A requires Option 30 - Monty McGraw 18Mar20232 GO TO 1003 REM UDKs:1=Rotate CCW, 2=Rotate CW, 4=Thrust, 5=Fire, 8=HyperSpace4 R=R+1 MOD 175 R=R+(R=0)6 RETURN 8 R=R-1 MOD 179 R=R+(R=0)*1610 RETURN 16 T=T+1 MOD 3  !0=none, 1=short burst of speed, 2=fast continuous speed17 T=T+(T=0)18 RETURN 20 F=F+1 MOD 2  !0=none, 1=fire one shot21 F=F+(F=0)22 RETURN 32 H=H+10 MOD 9999933 H=H+(H=0)34 RETURN 89   ! Option 30 Refresh Object #s (152 total individual objects)90   ! Multiple duplicate asteroid, missile and numeral objects required91   ! Type: 0=numeral,1-4=asteroid,5=ship,6=thrust, 7=missile, 8=alien92   ! -Asteroid object# (TSN): Type:1-4, Size:1/2/3, Number:1-4 or 1-893   ! Small asteroid#:   111-8, 211-8, 311-8, 411-894   ! Medium asteroid#:  121-4, 221-4, 321-4, 421-495   ! Large  asteroid#:  131-4, 231-4, 331-4, 431-496   ! Score Numeral#:    5-digit Score:1-5,11-15, ..., 91-95 for 0 to 997   ! Ships Left#:       521-524 vertical orientation below Score98   ! Player#:           501-516 Ship, 601-616=Thrust, 701-704 Missiles99   ! Alien#:            801=Large Alien, 802=Small Alien100 INIT 110 DIM Misl(4,5),Score(5),Prev(5),Num(10),Ast(26,8),B(11)120 Ast=0  !     Clear visible asteroid array170 R=1  !       Set initial Ship Rotation180 R0=1  !      Set previous Ship Rotation to same as R190 T=0  !       Set Thrust off200 Tt=0  !      Clear Thrust loop timer210 F=0  !       Set Fire off220 H=0  !       Set Hyper Space off230 GOSUB 400  ! Create all Option 30 Objects240 GOSUB 3460  !Create Asteroid objects for INSIDE collision detection250 GOSUB 4160  !init score, asteroids and ship260 SET KEY   !  Enable UDKs to rotate/move Player Ship280 DO   !        Start Main Game Loop290 SET NOKEY 300 CALL Astmov(A)310 CALL Showsc(Score,Prev,Num,_score,_prvscor)320 CALL Ckship(R)330 CALL Ckthrs(T)340 CALL Ckmisl(M)350   !  CALL Ckhypr(H)355   !  CALL AlienM(L)360 CALL Ckcoll(A)370 SET KEY 380 LOOP 390 END 400   ! Asteroids - create and then turn off all objects410 PAGE 420 DIM Obj(2,2)430 VIEWPORT 0,130,0,100440 WINDOW -650,650,-500,500  ! window is 0,0 centered 1300x1000 grid450 SET DEGREES 460 X=RND(-1)465 DELETE X470 BRIGHTNESS 0480   ! Option 30 RDRAW Data: BaseObj,Numobj,_Scale,Numvec,x0,y0490   !                       x1 to xLast and y1 to yLast500 DATA 111,8,3,10,12,0510 DATA 4,-12,-12,-8,0,8,8,8,8,-4520 DATA -8,-8,0,8,16,8,-8,8,-8,-8530 DATA 211,8,3,12,8,4540 DATA 8,-8,-12,-4,-8,4,-4,8,8,8,8,-8550 DATA -8,-12,4,-4,8,8,8,8,-4,4,-8,-4820 DATA 0825 L=1830 READ Baseobj832 IF Baseobj=0 THEN 920834 READ Numobj,_scale,Numvec,X0,Y0835 Obj(L,1)=Baseobj836 Obj(L,2)=Numobj837 L=L+1839 DIM X(Numvec),Y(Numvec)840 READ X,Y845 J0=1850 FOR J=1 TO _scale855 M=(J=1)+(J>1)*2860 X0=X0*M865 Y0=Y0*M870 X=X*M875 Y=Y*M880 FOR I=Baseobj TO Baseobj+Numobj-1885 MOVE 0,0890 ROPEN I+10*J895 RMOVE X0,Y0900 RDRAW X,Y905 RCLOSE 910 NEXT I915 NEXT J917 GO TO 830920   ! Now test that you have all asteroid #1 objects924 FOR L=1 TO 2925 FOR J=1 TO _scale930 K=1935 FOR I=Obj(L,1) TO Obj(L,1)+Obj(L,2)-1940 STPOINT I+J*10,-650+K*150,J*111-550945 VISIBILITY I+J*10,1950 K=K+1955 NEXT I960 NEXT J970 END 1000 REM keep going