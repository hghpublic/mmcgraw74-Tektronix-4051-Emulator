100 REM Asteroids test - load and display Highest Score102 REM file format: obj#, X,Y, then D or M (1 or 2),X,Y,...104 REM end of object: 0,0,0   Then -1,0,0 for end of file110 INIT 115 PAGE 116 DIM O0(9),X0(9),Y0(9)117 I=0120 FIND @5:63130 READ @5:O1,X,Y131 I=I+1135 IF O1=-1 THEN 210136 O0(I)=O1137 X0(I)=X138 Y0(I)=Y140 MOVE X,Y150 READ @5:D0,X,Y152 IF D0=0 THEN 130160 GO TO D0 OF 170,190170 RDRAW X,Y180 GO TO 150190 RMOVE X,Y200 GO TO 150210 CLOSE 220 HOME 230 END 