100   ! 4054A Score test program for Asteroids110 INIT 120 I=RND(-1)130 I=RND(1)140 PRINT "Asteroids SCORE Testcreating 250 numeral objects...";150   ! Hi_scores - max five digits in two sizes (max of 4 dupes/score)160   !   Large: Score1 player1 current score at top left170   !          Score2 player2 current score at top right (2 player)180   !          Ten Large Hi_scores (High Score screen only)190   !   Small: Top Score centered in middle of top (on all screens)200   ! Option 30 SCORE objects: 210   !   Large #: (10 High+2 Player scores)*10 digits*20 220   !        Objects: (Digit*100+1001) 0=1001-1020 to 9=1901-1920230   !   Periods for UP TO 10 HIGH scores: 1061 to 1070240   !   Small #: 1 Top score*10 Digits*4 duplicates=40250   !        Objects: (Digit*100+1025) 0=1021-1025 to 9=1921-1925260   !   Large Capital Letters: Large player names: 3*10*26 = 720270   !        Objects: (Letter*1000+10001) A=10001-10030 to Z=26001-30280   !     Small 2023 MCM logo string on bottom of screen - 1 object290 DIM Hi_score(10),Names$(30),Num_avail$(240),Period$(10)300   ! Init Scoring variables: Score() contains HiScore for 1-10310 DATA "                              ","",0,0,0,"",0320 READ Names$,Num_avail$,Hiscores,Score1,Score2,Period$330   ! INIT Object30 score numerals and mark them available 340 REM Number Objects: Base Obj#, #vecs, 21 or 20(MV/DR),x,y350 DATA 1000,4,20,4,0,20,0,-6,20,-4,0,20,0,6360 DATA 1100,2,21,2,0,20,0,-6370 DATA 1200,5,20,4,0,20,0,-3,20,-4,0,20,0,-3,20,4,0380 DATA 1300,5,20,4,0,20,0,-6,20,-4,0,21,0,3,20,4,0390 DATA 1400,4,20,0,-3,20,4,0,21,0,3,20,0,-6400 DATA 1500,6,21,4,0,20,-4,0,20,0,-3,20,4,0,20,0,-3,20,-4,0410 DATA 1600,4,20,0,-6,20,4,0,20,0,3,20,-4,0420 DATA 1700,2,20,4,0,20,0,-6430 DATA 1800,6,20,4,0,20,0,-6,20,-4,0,20,0,6,21,0,-3,20,4,0440 DATA 1900,5,21,4,-3,20,-4,0,20,0,3,20,4,0,20,0,-6450 DATA 1060,2,21,6,-6,20,0,0460 DATA 0,0470 RESTORE 350480 DO 490 READ Basenum,Vectors500 EXIT IF Basenum=0510 DELETE N520 DIM N(Vectors,3)530 READ N540 IF Basenum<>1060 THEN 570550 FOR J=1 TO 10560 GO TO 580570 FOR J=1 TO 24580 MOVE 65,50590 ROPEN Basenum+J600 VISIBILITY Basenum+J,0610 FOR I=1 TO Vectors620 IF J>20 THEN 680630 GO TO N(I,1)-19 OF 640,660640 RDRAW N(I,2)/2,N(I,3)/2650 GO TO 720660 RMOVE N(I,2)/2,N(I,3)/2670 GO TO 720680 GO TO N(I,1)-19 OF 690,710690 RDRAW N(I,2)/4,N(I,3)/4700 GO TO 720710 RMOVE N(I,2)/4,N(I,3)/4720 NEXT I730 RCLOSE 740 IF Basenum<>1060 THEN 770750 Period$=Period$&"1"760 GO TO 790770 Num_avail$=Num_avail$&"1"  ! 1=available, 0=visible780   ! Numeral Object#= INT(index/24)*100+(index MOD 24)+1000790 NEXT J800 LOOP 810 REM Test numbers - 10 random high scores, 2 Player Scores820 FOR I=1 TO 10830 Hi_score(I)=INT(RND(1)*9999)*10840 NEXT I850 PRINT "";Hi_score860 GOSUB 1380  ! sort the Hi_score array870 PRINT " ";Hi_score880   ! Now display the indexes, period, and hiscore for 1-10890   ! 48.6,71.6 lower left corner of 1, Y pitch of -3.9900 S$="12"  ! set a search string to detect next avail numeral910 Flag=0920 FOR I=1 TO 10930 High=Hi_score(I)940 IF High=0 THEN 1230950 IF I<>10 THEN 980960 Flag=1970 I=1980 X=48.6-2.6*(Flag=1)990 Y=71.6-(I+(Flag=1)*9+(Flag=2)*10-1)*4.31000 Num=I1010 GOSUB 1270  ! Display this numeral object1020   ! now display a dot for a period after the numeral, skip Flag=11030 IF Flag=1 THEN 10801040 STPOINT 1060+I+(I=0)*10,48.6,71.6-(I+(Flag=2)*10-1)*4.31050 VISIBILITY 1060+I+(I=0)*10,11060 Period$=REP("0",I+(I=0)*10,1)1070 IF Flag=0 THEN 11401080 GO TO Flag OF 1090,1120  ! Flag=1 1 digit was displayed for 101090 I=01100 Flag=21110 GO TO 9801120 Flag=0  ! Reset Flag and set I to 10 to end FOR/NEXT I loop1130 I=101140   ! Now make corresponding high score visible1150 H$=STR(Hi_score(I))1160 FOR J=LEN(H$) TO 2 STEP -1  ! STR index 1 is always blank1170 J$=SEG(H$,J,1)1180 Num=VAL(J$)1190 X=48.6+17+2.6*(J-LEN(H$))1200 Y=71.6-(I-1)*4.31210 GOSUB 12701220 NEXT J1230 NEXT I1240 PRINT "num_avail"1241 FOR I=0 TO 91242 H$=SEG(Num_avail$,I*24+1,20)1243 PRINT I;" ";H$1244 NEXT I1250 END 1260   ! Make numeral Object Num visible at X,Y1270 N0=SEARCH(Num_avail$,S$,Num*24+1)  ! find available numeral object1280 IF N0<>0 AND N0-Num*24+1<21 THEN 13201290 T$=SEG(Num_avail$,Num*24+1,20)1300 PRINT "Error: ";Num;" not availableNum_avail$:'";T$;"'"1310 END 1320 Obj_num=INT(N0/24)*100+(N0 MOD 24)+10001330 STPOINT Obj_num,X,Y1340 VISIBILITY Obj_num,11350 Num_avail$=REP("0",N0,1)  !            insert 0 for used1360 RETURN 1370   ! sort the Hiscore() in decreasing order1380 A2=101390 FOR A1=A2 TO 2 STEP -11400 DIM Hi_score(A1)1410 CALL "MIN",Hi_score,V,I1420 A3=Hi_score(A1)1430 Hi_score(A1)=V1440 Hi_score(I)=A31450 NEXT A11460 DIM Hi_score(A2)1470 RETURN 