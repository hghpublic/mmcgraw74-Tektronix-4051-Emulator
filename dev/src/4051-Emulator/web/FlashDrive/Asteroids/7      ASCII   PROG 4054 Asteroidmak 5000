8150 RESTORE 86908160 REM Object#: 151-166 Ship,171-186=Thrust plume, 22.5 deg rotates8170 REM Object#: 101,102,103 asteroid 1, 201,202,203 S/M/L asteroid 28180 REM Object#: 301,302,303 asteroid 3, 401,402,403 S/M/L asteroid 48190 REM Z DATA#: 9 close file, 8 end obj, 6-7 rot obj, 1 rdraw, 0 rmove8200 REM X and Y are coords except for Z=2 where X=Object# & Y=Y offset8210 READ X,Y,Z8220 X0=08230 IF Z=6 THEN 82708235 IF Z=7 THEN 85608240 IF Z<>2 THEN 84808250 O1=X8255 V1=08256 U=08260 GO TO 83208270 O9=O9+1  !O1 increments for each rotation for ship and thrust8280 O1=X+O98290 ROTATE 22.5*(O9-1)8300 REM don't move Y to keep all rotates centered8310 GO TO 84308320 IF X<150 THEN 84308330 IF X>300 THEN 83708340 X0=1758350 REM BRIGHTNESS 08360 GO TO 84308370 IF X>400 THEN 84108380 X0=3508390 REM BRIGHTNESS 38400 GO TO 84308410 X0=5258420 REM BRIGHTNESS 28430 MOVE X0,Y8440 ROPEN O18450 REM BRIGHTNESS 28460 VISIBILITY O1,18470 GO TO 82108480 IF Z=7 THEN 85608490 IF Z=8 THEN 86208500 IF Z=9 THEN 90608510 IF Z=1 THEN 85408520 RMOVE X,Y8525 V1=V1+18526 U(1,V1)=218527 U(2,V1)=X8528 U(3,V1)=Y8530 GO TO 82108540 RDRAW X,Y8545 V1=V1+18546 U(1,V1)=208547 U(2,V1)=X8548 U(3,V1)=Y8550 GO TO 82108560 IF O1<166 THEN 86208570 IF O1=166 THEN 86508580 IF O1=186 THEN 86208590 RESTORE 87108595 GOSUB 95008600 GO TO 86208610 ROTATE 08620 RESTORE 86908624 GOSUB 95008625 VISIBILITY O1,08630 RCLOSE 8640 GO TO 82108650 O9=08655 RESTORE 87108656 GOSUB 95008660 GO TO 86208670 REM All objects are RDRAW'n starting from a 0,0 center8680 REM RDRAW Data for Player Ship 1 and Thrust 18690 DATA 150,0,6,28,0,0,-48,-16,1,8,8,1,0,16,1,-8,8,1,48,-16,18700 DATA 150,0,78710 DATA 160,0,6,-12,-8,0,-16,8,1,16,8,1,160,0,78720 REM RDRAW Data for Tiny/Small/Med/Large asteroids 108730 DATA 101,0,2,12,0,0,4,-8,1,-12,-8,1,-12,0,1,-8,8,1,0,16,1,8,8,18740 DATA 8,-8,1,8,8,1,8,-8,1,-4,-8,1,8,8,88750 DATA 102,0,2,24,0,0,8,-16,1,-24,-16,1,-24,0,1,-16,1