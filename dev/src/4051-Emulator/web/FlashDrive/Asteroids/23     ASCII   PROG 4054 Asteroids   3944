er Ship260 DO   !        Start Main Game Loop270 SET NOKEY 280 CALL Astmov(A)290 CALL Showsc(Score,Prev,Num,_score,_prvscor)300 CALL Ckship(R)310 CALL Ckthrs(T)320 CALL Ckmisl(M)330   !  CALL Ckhypr(H)340   !  CALL AlienM(L)350 CALL Ckcoll(A)360 SET KEY 370 LOOP 380 END 390   ! Asteroids - create and then turn off all objects400 PAGE 410 DIM Ast(13,2)  ! Asteroid baseobject,_scale412 Ast(13,1)=0414 Ast(13,2)=0420 VIEWPORT 0,130,0,100430 WINDOW -650,650,-500,500  ! window is 0,0 centered 1300x1000 grid450 X=RND(-1)460 DELETE X470 BRIGHTNESS 0480   !Option 30 RDRAW Data: BaseObj,_Scale,{n1 to nLast},Numvec,x0,y0481   !                       x1 to xLast and y1 to yLast482 DATA 111,3,8,4,4,10,12,0  !                Small Asteroid 1483 DATA 4,-12,-12,-8,0,8,8,8,8,-4484 DATA -8,-8,0,8,16,8,-8,8,-8,-8486 DATA 211,3,8,4,4,12,8,4  !                 Small Asteroid 2487 DATA 8,-8,-12,-4,-8,4,-4,8,8,8,8,-8488 DATA -8,-12,4,-4,8,8,8,8,-4,4,-8,-4489 DATA 311,3,8,4,4,11,16,4  !                Small Asteroid 3490 DATA 0,-8,-8,0,-8,-8,8,-8,12,12,8491 DATA -8,-12,0,12,-12,12,4,4,12,0,-12492 DATA 411,3,8,4,4,12,4,0  !                 Small Asteroid 4493 DATA 12,-8,-4,-12,-8,0,12,-4,12,12,0,-12494 DATA -8,-8,4,-4,12,12,0,8,0,-8,-4,-4495 DATA 501,-1,19,5,28,0  !                   Player Ship496 DATA -48,8,0,-8,48497 DATA -16,8,16,8,-16498 DATA 601,-1,16,2,-12,-8  !                 Thrust cone499 DATA -16,16,8,8560 DATA 0,0570 L=1580 READ Baseobj,_scale590 Ast(L,1)=Baseobj600 Ast(L,2)=_scale610 IF Baseobj=0 THEN 1000620 IF _scale<>1 THEN 670630 READ Numobj,Numvec,X0,Y0  ! Single scale Alien1,Alien2,Missile640 DIM X(Numvec),Y(Numvec)650 READ X,Y660 GO TO 780670 IF _scale<0 THEN 731680 DIM _scal(_scale)  ! Multiple scale objects like Asteroids690 READ _scal,Numvec,X0,Y0700 DIM X(Numvec),Y(Numvec)710 READ X,Y720 GO TO 780731 READ Numobj,Numvec,X0,Y0  ! Rotated object like Ship or Thrust732 DIM X(Numvec),Y(Numvec)733 READ X,Y734 _scale=-_scale735   ! start ship or thrust create *********736 FOR I=1 TO Numobj737 IF I<17 THEN 740738 ROTATE 4*22.5  ! fixed vertical position for three extra ships739 GO TO 741740 ROTATE (I-1)*22.5  ! rotated positions for 16 ships or thrust741 MOVE 600*(RND(1)-0.5),600*(RND(1)-0.5)742 ROPEN I-1+Baseobj743 RMOVE X0,Y0744 RDRAW X,Y745 RCLOSE 746 NEXT I748 GO TO 580780 Ast(L,1)=Baseobj790 IF _scale=1 THEN 810800 Numobj=_scal(1)810 Ast(L,2)=Numobj820 L=L+1830 J0=1840 FOR J=1 TO _scale850 M=(J=1)+(J>1)*2860 X0=X0*M870 Y0=Y0*M880 X=X*M890 Y=Y*M900 Numobj=_scal(J)910 FOR I=Baseobj TO Baseobj+Numobj-1920 MOVE 600*(RND(1)-0.5),600*(RND(1)-0.5)930 ROPEN I+10*J940 RMOVE X0,Y0950 RDRAW X,Y960 RCLOSE 970 NEXT I980 NEXT J990 GO TO 5801000   ! Now test that you have all asteroid objects and duplicates1010 FOR L=1 TO 41020 _scale=Ast(L,2)1030 FOR J=1 TO _scale1040 K=11050 FOR I=Ast(L,1) TO Ast(L,1)+Ast(L,2)-11060 STPOINT I+J*10,-650+K*150,J*101-550+(L-1)*255+50*(J=1)-901070 VISIBILITY I+J*10,11080 K=K+11090 NEXT I1100 NEXT J1110 NEXT L1120   ! Now test that you have all ships with thrusts and extra ships1130 FOR I=1 TO 16  ! display 16 ships with thrust cones1140 STPOINT 500+I,175-_angle(I,1)*80,400-_angle(I,2)*801150 STPOINT 600+I,175-_angle(I,1)*80,400-_angle(I,2)*801160 NEXT I1170 FOR I=1 TO 3  ! now display three extra ships1180 STPOINT 516+I,400+I*50,3751190 NEXT I2000 END 2520 SUB Checkship(R)2530 IF R0=R THEN 2610  ! If no change in R don't rotate ship2540 LOCAL I2550 FOR I=1 TO 162560 IF I=R THEN 25902570 VISIBILITY 500+I,02580 VISIBILITY 600+I,02590 NEXT I2600 R0=R  ! update ship current rotation2610 END SUB 2620 SUB Checkthrust(T)2630 IF T=0 THEN 2830  ! If no thrust continue2640 IF T<>2 THEN 26602650 Tt=102660 IF Tt>0 THEN 26802670 Tt=102680 LOCAL I2690 FOR I=1 TO 162700 VISIBILITY 600+I,02710 NEXT I2720 VISIBILITY 600+R0,12730 Sx=Sx+COS((R0-1)*22.5)*(3+(T=2)*6)2740 IF ABS(Sx)<650 THEN 27602750 Sx=-Sx2760 Sy=Sy+SIN((R0-1)*22.5)*(3+(T=2)*6)2770 IF ABS(Sy)<500 THEN 27902780 Sy=-Sy2790 Tt=Tt-0.252800 IF Tt>0 THEN 28302810 T=02820 VISIBILITY 600+R0,02830 STPOINT 500+R,Sx,Sy  ! set new ship rotation at current X,Y2840 STPOINT 600+R,Sx,Sy  ! set new ship thrust at current X,Y2850 VISIBILITY 500+R0,1  ! make ship visible2860 END SUB 